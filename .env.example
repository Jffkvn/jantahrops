# --- Supabase ---
# Project URL and anon key. The anon key is public by design and safe in the
# browser bundle. The SERVICE ROLE key is NOT here and must never be — it
# belongs only in Supabase Edge Function secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- App ---
# Base URL of this app, used for links inside notification emails.
VITE_APP_URL=http://localhost:5180
# 'development' | 'staging' | 'production'
VITE_APP_ENV=development
